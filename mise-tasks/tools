#!/usr/bin/env bash
#MISE description="Install runtimes and CLI tools pinned in the mise config"
#MISE depends=["link"]
set -euo pipefail

# Anonymous GitHub API calls are capped at 60/h, fewer than the tools below
# need on a fresh machine. On later runs the shell has already exported it.
if [ -z "${MISE_GITHUB_TOKEN:-}" ]; then
  MISE_GITHUB_TOKEN="$(mise exec gh -- gh auth token 2>/dev/null || true)"
  export MISE_GITHUB_TOKEN
fi

# Reads ~/.config/mise/config.toml, which `link` puts in place.
mise install --yes

# Used by the gh-stack Claude skill. Needs `gh auth login`.
mise exec gh -- gh extension list | grep -q github/gh-stack ||
  mise exec gh -- gh extension install github/gh-stack
