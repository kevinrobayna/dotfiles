#!/usr/bin/env zsh

mkdir -p ~/dev
mkdir -p ~/personal

zoxide add ~/dev
zoxide add ~/personal

# Make sure everything under dev and personal is added to zoxide
if [ -n "$(find ~/dev/ -prune -empty -type d 2>/dev/null)" ]
then
else
  ls -d ~/dev/* | xargs -I {} zoxide add {}
fi

if [ -n "$(find ~/personal/ -prune -empty -type d 2>/dev/null)" ]
then
else
  ls -d ~/personal/* | xargs -I {} zoxide add {}
fi

sesh connect $(sesh list -i | gum filter --limit 1 --placeholder 'Pick a session' --height 60 --prompt='⚡')
